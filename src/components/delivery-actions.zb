<!--
  What a driver can do to one order, as plain forms. Each posts to a 'use server' function: a
  native post without JavaScript, a fetch with it. The server decides, so two drivers pressing
  Claim at once get one winner and one message.
-->
<script>
  import './action-button.zb'
  import './alert-banner.zb'

  let problem = ''

  export async function claim(formData, context) {
    'use server'
    const done = await context.market.claim(context.person, formData)
    if (done.error) return done
    return Response.redirect(new URL('/drive?done=claimed', context.request.url), 303)
  }

  export async function pickUp(formData, context) {
    'use server'
    const done = await context.market.advance(context.person, formData, 'picked')
    if (done.error) return done
    return Response.redirect(new URL('/drive?done=picked', context.request.url), 303)
  }

  export async function deliver(formData, context) {
    'use server'
    const done = await context.market.advance(context.person, formData, 'delivered')
    if (done.error) return done
    return Response.redirect(new URL('/drive?done=delivered', context.request.url), 303)
  }

  const show = (event) => (problem = event.detail.value?.error ?? event.detail.error ?? '')
</script>
<style>
  form { display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; }
  alert-banner { flex-basis: 100%; }
</style>
<delivery-actions order="" stage="placed">
  <zb-switch value={stage}>
    <zb-case is="placed">
      <form action={claim} onaction={show}>
        <input type="hidden" name="order" value={order}>
        <action-button type="submit">Claim delivery</action-button>
        <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      </form>
    </zb-case>
    <zb-case is="claimed">
      <form action={pickUp} onaction={show}>
        <input type="hidden" name="order" value={order}>
        <action-button type="submit">Picked up</action-button>
        <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      </form>
    </zb-case>
    <zb-case is="picked">
      <form action={deliver} onaction={show}>
        <input type="hidden" name="order" value={order}>
        <action-button type="submit">Delivered</action-button>
        <alert-banner zb-if={problem} variant="danger">{problem}</alert-banner>
      </form>
    </zb-case>
  </zb-switch>
</delivery-actions>
