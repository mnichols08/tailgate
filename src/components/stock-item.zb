<!--
  One row of a farm's stock: its own Sync document ('use collection listings by farm, item'), so
  the farmer editing the price and the server taking stock for an order touch different fields
  and both survive.
  @fires remove - The farmer removed this row; `detail` is the item id.
-->
<script>
  'use collection listings by farm, item'
  import { emit } from '@zubra/runtime'
  import './money-input.zb'

  let name = ''
  let unit = 'each'
  let price = 0
  let qty = 0
</script>
<style>
  .row { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr auto; gap: 0.5rem; align-items: start; }
  .row { transition: opacity 0.25s; @starting-style { opacity: 0; } }
  input { font: inherit; min-width: 0; padding: 0.6rem 0.75rem; border: 1px solid var(--border); border-radius: 0.5rem; background: var(--background); }
  input.out { border-color: #c98a2b; }
  button { font: inherit; border: 0; background: transparent; color: var(--muted-foreground); cursor: pointer; padding: 0.4rem; }
</style>
<stock-item farm="" item="">
  <div class="row">
    <input aria-label="Item" placeholder="Item name" value={name} oninput={(event) => (name = event.target.value)}>
    <input aria-label="Unit" value={unit} oninput={(event) => (unit = event.target.value)}>
    <money-input label="Price in dollars" value={price} onvaluechange={(event) => (price = event.detail ?? 0)}></money-input>
    <input aria-label="Quantity" type="number" min="0" step="1" value={qty} class:out={qty === 0} oninput={(event) => (qty = Number(event.target.value))}>
    <button type="button" aria-label="Remove {name || 'item'}" onclick={() => emit('remove', item)}>✕</button>
  </div>
</stock-item>
