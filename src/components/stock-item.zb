<!--
  One row of a farm's stock: its own Sync document ('use collection listings by farm, item'), so
  the farmer editing the price and the server taking stock for an order touch different fields
  and both survive.
  @fires remove - The farmer removed this row; `detail` is the item id.
-->
<script>
  'use collection listings by farm, item'
  import { emit } from '@zubra/runtime'
  import './money-input.zb'
  import './quantity-stepper.zb'

  let name = ''
  let unit = 'each'
  let price = 0
  let qty = 0
</script>
<style>
  .row { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr auto; gap: 0.5rem; align-items: start; }
  input { width: 100%; }
  /* On a phone each row stacks: name across the top, then unit, price and quantity, each labelled. */
  .narrow-label { display: none; font-size: 0.8rem; color: var(--muted-foreground); }
  .row { transition: opacity 0.25s; @starting-style { opacity: 0; } }
  input { font: inherit; min-width: 0; padding: 0.6rem 0.75rem; border: 1px solid var(--border); border-radius: 0.5rem; background: var(--background); }
  .out input { border-color: #c98a2b; }
  button { font: inherit; border: 0; background: transparent; color: var(--muted-foreground); cursor: pointer; padding: 0.4rem; }
  /* On a phone each row wraps: name and remove on top, then unit and quantity, then price. */
  @media (max-width: 40rem) {
    .row { display: flex; flex-wrap: wrap; padding: 0.75rem; border-radius: var(--radius); background: var(--card); box-shadow: 0 0 0 1px var(--border); }
    .row > * { flex: 1 1 40%; min-width: 0; }
    .row > .name { flex: 1 1 calc(100% - 3rem); }
    .row > button { flex: 0 0 auto; }
    .row > .price { flex: 1 1 100%; order: 5; }
    .narrow-label { display: block; }
  }
</style>
<stock-item farm="" item="">
  <div class="row">
    <input class="name" aria-label="Item" placeholder="Item name" value={name} oninput={(event) => (name = event.target.value)}>
    <div><span class="narrow-label" aria-hidden="true">Unit</span><input aria-label="Unit" value={unit} oninput={(event) => (unit = event.target.value)}></div>
    <div class="price"><span class="narrow-label" aria-hidden="true">Price</span><money-input label="Price in dollars" value={price} onvaluechange={(event) => (price = event.detail ?? 0)}></money-input></div>
    <div class:out={qty === 0}><span class="narrow-label" aria-hidden="true">Quantity</span><quantity-stepper label="Quantity" editable min={0} max={9999} value={qty} onvaluechange={(event) => (qty = event.detail)}></quantity-stepper></div>
    <button type="button" aria-label="Remove {name || 'item'}" onclick={() => emit('remove', item)}>✕</button>
  </div>
</stock-item>
