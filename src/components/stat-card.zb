<!--
  One number that matters, with what it is and how it changed: revenue this month, active users,
  open tickets. `change` is the change as a percentage (positive or negative), said in words for
  screen readers ("up 12%"); `good` says which direction is good ("up" or "down"), so a falling
  error rate shows as good news.
-->
<script>
  const direction = change == null ? "" : change > 0 ? "up" : change < 0 ? "down" : "flat"
  const tone = direction === "flat" || !direction ? "neutral" : direction === good ? "good" : "bad"
  const changeText = change == null ? "" : `${direction === "up" ? "▲" : direction === "down" ? "▼" : "■"} ${Math.abs(change)}%`
  const spoken = change == null ? "" : direction === "flat" ? "no change" : `${direction} ${Math.abs(change)}%`
</script>
<style>
  :host { display: block; }
  .stat { display: grid; gap: 0.35rem; padding: 1.1rem 1.2rem; border: 1px solid var(--border, #e4e4e7); border-radius: var(--radius, 0.625rem); background: var(--card, #fff); color: var(--card-foreground, #18181b); }
  .stat-label { font-size: 0.85rem; font-weight: 600; color: color-mix(in oklab, var(--muted-foreground, #71717a) 75%, var(--foreground, #18181b)); }
  .stat-value { font-size: 1.75rem; font-weight: 750; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; line-height: 1.15; }
  .stat-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: color-mix(in oklab, var(--muted-foreground, #71717a) 75%, var(--foreground, #18181b)); }
  .stat-change { padding: 0.1rem 0.45rem; border-radius: 999px; font-weight: 700; }
  .stat-good { background: color-mix(in oklab, oklch(0.6 0.15 150) 16%, var(--background, #fff)); color: color-mix(in oklab, oklch(0.6 0.15 150) 50%, var(--foreground, #18181b)); }
  .stat-bad { background: color-mix(in oklab, var(--destructive, #dc2626) 14%, var(--background, #fff)); color: color-mix(in oklab, var(--destructive, #dc2626) 55%, var(--foreground, #18181b)); }
  .stat-neutral { background: var(--muted, #f4f4f5); }
  .stat-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
<stat-card label="" value="" change={null} good="up" period="">
  <div class="stat">
    <span class="stat-label">{label}</span>
    <span class="stat-value">{value}</span>
    <span zb-if={change != null || period} class="stat-foot">
      <span zb-if={change != null} class="stat-change stat-{tone}"><span aria-hidden="true">{changeText}</span><span class="stat-hidden">{spoken}</span></span>
      <span>{period}</span>
    </span>
  </div>
</stat-card>
