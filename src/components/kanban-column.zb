<!--
  A board column: a heading with a count and an optional work-in-progress limit, its cards (the
  default slot) and a drop zone for cards dragged from anywhere on the board.
  @slot - The cards: any elements with `draggable="true"`. A card dragged out of a column carries its `id` (or `data-id`, or its text) as `application/x-card` drag data, which the drop reports; set that data yourself to drag in from elsewhere.
  @slot actions - Buttons under the cards.
  @fires carddrop - A card was dropped here; `detail` is `{ id, index }` (where among the cards).
-->
<script>
  import { emit, hasSlot } from '@zubra/runtime'

  const hasActions = hasSlot('actions')
  let list = null
  let over = false
  const full = limit > 0 && count > limit

  /** Where among this column's cards a drop at `y` lands. */
  function indexAt(y) {
    const cards = [...list.children].filter((child) => !child.classList.contains('empty'))
    const after = cards.findIndex((card) => {
      const box = card.getBoundingClientRect()
      return y < box.top + box.height / 2
    })
    return after === -1 ? cards.length : after
  }
  // Cards dragged from a column carry their id, unless the page set drag data itself.
  function dragstart(event) {
    const card = event.target
    if (!card?.getAttribute || event.dataTransfer.types.includes('application/x-card')) return
    event.dataTransfer.setData('application/x-card', card.id || card.dataset.id || card.textContent.trim())
    event.dataTransfer.effectAllowed = 'move'
  }
  function dragover(event) {
    if (!event.dataTransfer.types.includes('application/x-card')) return
    event.preventDefault()
    event.dataTransfer.dropEffect = 'move'
    over = true
  }
  function drop(event) {
    const id = event.dataTransfer.getData('application/x-card')
    over = false
    if (!id) return
    event.preventDefault()
    emit('carddrop', { id, index: indexAt(event.clientY) })
  }
</script>
<style>
  :host { display: flex; flex-direction: column; min-width: 13rem; max-width: 20rem; flex: 1; }
  section { display: flex; flex-direction: column; flex: 1; padding: 0.6rem; border-radius: calc(var(--radius, 0.625rem) * 1.44); background: var(--column, var(--muted, #f4f4f5)); transition: background var(--duration-fast, 150ms), box-shadow var(--duration-fast, 150ms); }
  section.over { background: var(--column-over, color-mix(in oklab, var(--primary, #18181b) 10%, var(--muted, #f4f4f5))); box-shadow: inset 0 0 0 2px var(--primary, #4f5df5); }
  header { display: flex; align-items: center; gap: 0.5rem; padding: 0.25rem 0.35rem 0.6rem; }
  h2 { margin: 0; font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
  .count { padding: 0 0.45rem; border-radius: 999px; background: var(--card, #ffffff); font-size: 0.75rem; font-weight: 700; color: var(--muted-foreground, #667085); }
  .full .count { background: var(--destructive, #d92d20); color: white; }
  /* Muted text on the muted column: nudged toward the foreground for 4.5:1. */
  .limit { margin-left: auto; font-size: 0.75rem; color: color-mix(in oklab, var(--muted-foreground, #71717a) 75%, var(--foreground, #18181b)); }
  .full .limit { color: var(--destructive, #d92d20); font-weight: 700; }
  .cards { display: flex; flex-direction: column; gap: 0.5rem; flex: 1; min-height: 4rem; }
  footer { display: flex; flex-direction: column; }
  .empty { display: grid; place-items: center; flex: 1; min-height: 4rem; border: 2px dashed var(--border, #d9dce3); border-radius: calc(var(--radius, 0.625rem) * 1.12); color: var(--muted-foreground, #667085); font-size: 0.8125rem; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0s !important; animation-duration: 0s !important; animation-iteration-count: 1 !important; } }
</style>
<kanban-column heading="" count={0} limit={0}>
  <section class:over class:full aria-label={heading} ondragstart={dragstart} ondragover={dragover} ondragleave={(event) => event.currentTarget.contains(event.relatedTarget) || (over = false)} ondrop={drop}>
    <header>
      <h2>{heading}</h2>
      <span class="count">{count}</span>
      <span zb-if={limit > 0} class="limit">{full ? `over the limit of ${limit}` : `limit ${limit}`}</span>
    </header>
    <div class="cards" ref={list}>
      <zb-slot><div class="empty">Drop cards here</div></zb-slot>
    </div>
    <footer zb-if={hasActions}><zb-slot name="actions"></zb-slot></footer>
  </section>
</kanban-column>
